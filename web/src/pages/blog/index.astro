---
import { sanityClient } from "../../lib/sanity";

const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  publishedAt,
  excerpt,
  metaDescription,
  "coverImageUrl": mainImage.asset->url,
  "coverImageAlt": mainImage.alt
}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <title>Engineering & Architecture Blog — FlashProof</title>
    <meta name="description" content="Technical deep dives into high-performance WooCommerce architecture, database transient optimization, and zero-bloat conversion engineering." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --color-bg: #070b14;
        --color-surface: rgba(15, 23, 42, 0.7);
        --color-surface-hover: rgba(30, 41, 59, 0.85);
        --color-border: rgba(51, 65, 85, 0.5);
        --color-border-hover: rgba(56, 189, 248, 0.4);
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-accent: #38bdf8;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.6;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      /* Zero-JS, GPU-accelerated ambient background */
      .ambient-glow-1 {
        position: fixed;
        top: -150px;
        right: -100px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, rgba(56, 189, 248, 0) 70%);
        pointer-events: none;
        z-index: 0;
      }

      .ambient-glow-2 {
        position: fixed;
        bottom: -200px;
        left: -150px;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.06) 0%, rgba(99, 102, 241, 0) 70%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(32px, 5vw, 64px) 24px clamp(60px, 8vw, 100px);
        position: relative;
        z-index: 1;
      }

      /* Header */
      .blog-header {
        margin-bottom: clamp(36px, 6vw, 56px);
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 24px;
        transition: transform 0.15s ease;
      }

      .back-link:hover {
        transform: translateX(-2px);
      }

      .badge-tag {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: var(--color-accent);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      h1.page-title {
        font-size: clamp(2.2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin: 0 0 16px 0;
        background: linear-gradient(180deg, #ffffff 30%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .page-desc {
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        color: var(--color-text-muted);
        max-width: 680px;
        margin: 0;
        line-height: 1.6;
      }

      /* Bento Grid Layout */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
      }

      .bento-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
      }

      .bento-card:hover {
        transform: translateY(-4px);
        border-color: var(--color-border-hover);
        background: var(--color-surface-hover);
        box-shadow: 0 16px 32px -12px rgba(56, 189, 248, 0.12);
      }

      /* Bento Span Configurations */
      /* Card 1: Primary Spotlight (7 cols) */
      .bento-card:nth-child(1) {
        grid-column: span 7;
      }

      /* Card 2: Secondary Spotlight (5 cols) */
      .bento-card:nth-child(2) {
        grid-column: span 5;
      }

      /* Card 3: Complementary (5 cols) */
      .bento-card:nth-child(3) {
        grid-column: span 5;
      }

      /* Card 4: Complementary (7 cols) */
      .bento-card:nth-child(4) {
        grid-column: span 7;
      }

      /* Cards 5 & 6+: 4 columns each (3 per row) */
      .bento-card:nth-child(n+5) {
        grid-column: span 4;
      }

      .thumb-wrap {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #0b1120;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
      }

      .thumb-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }

      .bento-card:hover .thumb-wrap img {
        transform: scale(1.02);
      }

      .card-body {
        padding: clamp(20px, 3vw, 28px);
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .card-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .card-meta time {
        font-size: 0.8rem;
        color: var(--color-text-muted);
      }

      h2.card-title {
        font-size: clamp(1.15rem, 2vw, 1.35rem);
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 12px 0;
        color: #ffffff;
      }

      .bento-card:nth-child(1) h2.card-title {
        font-size: clamp(1.3rem, 2.4vw, 1.6rem);
      }

      .card-excerpt {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0 0 20px 0;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .read-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.9rem;
        color: var(--color-accent);
        font-weight: 600;
        margin-top: auto;
      }

      /* Responsive Breakpoints */
      @media (max-width: 960px) {
        .bento-card:nth-child(n) {
          grid-column: span 6;
        }
      }

      @media (max-width: 640px) {
        .bento-grid {
          grid-template-columns: 1fr;
          gap: 18px;
        }

        .bento-card:nth-child(n) {
          grid-column: span 1;
        }
      }
    </style>
  </head>
  <body>
    <div class="ambient-glow-1" aria-hidden="true"></div>
    <div class="ambient-glow-2" aria-hidden="true"></div>

    <main id="main-content">
      <div class="container">
        <header class="blog-header">
          <a href="/" class="back-link">&larr; Back to FlashProof Home</a>
          <div>
            <span class="badge-tag">Knowledge Base &amp; Benchmarks</span>
            <h1 class="page-title">Engineering Articles</h1>
            <p class="page-desc">In-depth technical guides on performance-focused WooCommerce architectures, native caching strategies, and layout optimization.</p>
          </div>
        </header>

        <section class="bento-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="bento-card">
              {post.coverImageUrl && (
                <div class="thumb-wrap">
                  <img 
                    src={post.coverImageUrl} 
                    alt={post.coverImageAlt || post.title} 
                    loading="lazy" 
                    decoding="async" 
                  />
                </div>
              )}
              <div class="card-body">
                <div class="card-meta">
                  <time datetime={post.publishedAt}>
                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}
                  </time>
                </div>
                <h2 class="card-title">{post.title}</h2>
                <p class="card-excerpt">
                  {post.metaDescription || post.excerpt || "Explore the technical implementation and architectural details of this post."}
                </p>
                <span class="read-cta">Read Architecture &rarr;</span>
              </div>
            </a>
          ))}
        </section>
      </div>
    </main>
  </body>
</html>
