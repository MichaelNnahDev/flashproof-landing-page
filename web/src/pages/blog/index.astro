---
import { sanityClient } from "../../lib/sanity";

const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  publishedAt,
  excerpt,
  metaDescription,
  "coverImageUrl": mainImage.asset->url,
  "coverImageAlt": mainImage.alt
}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <title>Blog & Technical Guides — FlashProof</title>
    <meta name="description" content="Technical deep dives into high-performance WooCommerce architecture, database transient optimization, and zero-bloat conversion engineering." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --color-bg: #040711;
        --color-surface: rgba(15, 23, 42, 0.72);
        --color-surface-hover: rgba(30, 41, 59, 0.9);
        --color-border: rgba(51, 65, 85, 0.6);
        --color-border-hover: rgba(56, 189, 248, 0.5);
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-accent: #38bdf8;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.6;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      /* Prominent GPU Aurora Background Stage */
      .aurora-stage {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
      }

      /* Subtle Grid Mesh for Architectural Texture */
      .bg-grid {
        position: absolute;
        inset: 0;
        background-image: 
          linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 80%);
      }

      /* Floating Fluid Aurora Orbs */
      .aurora-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        will-change: transform, opacity;
      }

      .orb-1 {
        top: -150px;
        left: -100px;
        width: 650px;
        height: 650px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.28) 0%, rgba(14, 165, 233, 0.08) 60%, transparent 80%);
        animation: driftOrb1 18s ease-in-out infinite alternate;
      }

      .orb-2 {
        top: 25%;
        right: -150px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.24) 0%, rgba(79, 70, 229, 0.06) 60%, transparent 80%);
        animation: driftOrb2 22s ease-in-out infinite alternate;
      }

      .orb-3 {
        bottom: -200px;
        left: 20%;
        width: 750px;
        height: 750px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.18) 0%, rgba(56, 189, 248, 0.05) 60%, transparent 80%);
        animation: driftOrb3 26s ease-in-out infinite alternate;
      }

      @keyframes driftOrb1 {
        0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); opacity: 0.7; }
        50% { transform: translate3d(120px, 80px, 0) scale(1.18) rotate(45deg); opacity: 0.95; }
        100% { transform: translate3d(-60px, 140px, 0) scale(0.92) rotate(-30deg); opacity: 0.75; }
      }

      @keyframes driftOrb2 {
        0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.65; }
        50% { transform: translate3d(-140px, 110px, 0) scale(1.22); opacity: 0.95; }
        100% { transform: translate3d(40px, -70px, 0) scale(0.95); opacity: 0.7; }
      }

      @keyframes driftOrb3 {
        0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.6; }
        50% { transform: translate3d(160px, -120px, 0) scale(1.25); opacity: 0.9; }
        100% { transform: translate3d(-100px, -60px, 0) scale(0.9); opacity: 0.65; }
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(32px, 5vw, 64px) 24px clamp(60px, 8vw, 100px);
        position: relative;
        z-index: 1;
      }

      .blog-header {
        margin-bottom: clamp(32px, 5vw, 48px);
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 24px;
        transition: transform 0.15s ease;
      }

      .back-link:hover {
        transform: translateX(-2px);
      }

      .badge-tag {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 9999px;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: var(--color-accent);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 16px;
        box-shadow: 0 0 15px rgba(56, 189, 248, 0.15);
      }

      .page-desc {
        font-size: clamp(1.15rem, 2.2vw, 1.4rem);
        color: #f1f5f9;
        max-width: 720px;
        margin: 0;
        line-height: 1.5;
        font-weight: 500;
      }

      /* Bento Grid Layout */
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
      }

      .bento-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
      }

      .bento-card:hover {
        transform: translateY(-4px);
        border-color: var(--color-border-hover);
        background: var(--color-surface-hover);
        box-shadow: 0 20px 36px -12px rgba(56, 189, 248, 0.2);
      }

      .bento-card:nth-child(1) { grid-column: span 7; }
      .bento-card:nth-child(2) { grid-column: span 5; }
      .bento-card:nth-child(3) { grid-column: span 5; }
      .bento-card:nth-child(4) { grid-column: span 7; }
      .bento-card:nth-child(n+5) { grid-column: span 4; }

      .thumb-wrap {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #0b1120;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
      }

      .thumb-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }

      .bento-card:hover .thumb-wrap img {
        transform: scale(1.02);
      }

      .card-body {
        padding: clamp(20px, 3vw, 28px);
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .card-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .card-meta time {
        font-size: 0.8rem;
        color: var(--color-text-muted);
      }

      h2.card-title {
        font-size: clamp(1.15rem, 2vw, 1.35rem);
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 12px 0;
        color: #ffffff;
      }

      .bento-card:nth-child(1) h2.card-title {
        font-size: clamp(1.3rem, 2.4vw, 1.6rem);
      }

      .card-excerpt {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0 0 20px 0;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .read-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.9rem;
        color: var(--color-accent);
        font-weight: 600;
        margin-top: auto;
      }

      @media (max-width: 960px) {
        .bento-card:nth-child(n) { grid-column: span 6; }
      }

      @media (max-width: 640px) {
        .bento-grid {
          grid-template-columns: 1fr;
          gap: 18px;
        }
        .bento-card:nth-child(n) { grid-column: span 1; }
      }
    </style>
  </head>
  <body>
    <div class="aurora-stage" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="aurora-orb orb-1"></div>
      <div class="aurora-orb orb-2"></div>
      <div class="aurora-orb orb-3"></div>
    </div>

    <main id="main-content">
      <div class="container">
        <header class="blog-header">
          <a href="/" class="back-link">&larr; Back to FlashProof Home</a>
          <div>
            <span class="badge-tag">Insights &amp; Knowledge Base</span>
            <p class="page-desc">In-depth technical guides on performance-focused WooCommerce architectures, native caching strategies, and layout optimization.</p>
          </div>
        </header>

        <section class="bento-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="bento-card">
              {post.coverImageUrl && (
                <div class="thumb-wrap">
                  <img 
                    src={post.coverImageUrl} 
                    alt={post.coverImageAlt || post.title} 
                    loading="lazy" 
                    decoding="async" 
                  />
                </div>
              )}
              <div class="card-body">
                <div class="card-meta">
                  <time datetime={post.publishedAt}>
                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}
                  </time>
                </div>
                <h2 class="card-title">{post.title}</h2>
                <p class="card-excerpt">
                  {post.metaDescription || post.excerpt || "Explore the technical implementation and architectural details of this post."}
                </p>
                <span class="read-cta">Continue reading &rarr;</span>
              </div>
            </a>
          ))}
        </section>
      </div>
    </main>
  </body>
</html>
