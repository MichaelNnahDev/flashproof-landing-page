---
import { sanityClient } from "../../lib/sanity";

const query = `*[_type == "post"] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  publishedAt,
  excerpt,
  "coverImageUrl": mainImage.asset->url
}`;

const posts = await sanityClient.fetch(query);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>FlashProof Blog — WooCommerce Performance & Social Proof</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body { font-family: -apple-system, sans-serif; background: #0b0f19; color: #f8fafc; padding: 40px 20px; }
      .container { max-width: 900px; margin: 0 auto; }
      .grid { display: grid; gap: 24px; margin-top: 30px; }
      .card { background: #1e293b; padding: 24px; border-radius: 12px; text-decoration: none; color: inherit; border: 1px solid #334155; }
      .card:hover { border-color: #4f46e5; }
      .title { font-size: 1.4rem; font-weight: 700; margin-bottom: 8px; color: #fff; }
      .desc { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Latest Articles</h1>
      <div class="grid">
        {posts.map((post: any) => (
          <a href={`/blog/${post.slug}`} class="card">
            <h2 class="title">{post.title}</h2>
            <p class="desc">{post.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>
