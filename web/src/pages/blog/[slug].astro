---
import { sanityClient } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Link from "../../components/portabletext/Link.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{
    "params": { "slug": slug.current }
  }`);
  return posts;
}

const { slug } = Astro.params;

// Fetch current post
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    body,
    publishedAt,
    excerpt,
    metaDescription,
    "coverImageUrl": mainImage.asset->url,
    "coverImageAlt": mainImage.alt
  }`,
  { slug }
);

// Fetch the 6 most recent posts (excluding current post)
const recentPosts = await sanityClient.fetch(
  `*[_type == "post" && defined(slug.current) && slug.current != $slug] | order(publishedAt desc)[0...6] {
    title,
    "slug": slug.current,
    publishedAt,
    excerpt,
    "coverImageUrl": mainImage.asset->url,
    "coverImageAlt": mainImage.alt
  }`,
  { slug }
);

const portableTextComponents = {
  mark: {
    link: Link,
  },
};
---

<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <meta charset="utf-8" />
    <title>{post?.title ? `${post.title} — FlashProof` : "FlashProof Blog"}</title>
    <meta name="description" content={post?.metaDescription || post?.excerpt || post?.title || "FlashProof Sales Popup for Woo"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --color-bg: #040711;
        --color-surface: rgba(17, 24, 39, 0.72);
        --color-surface-hover: rgba(31, 41, 55, 0.9);
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-text-body: #cbd5e1;
        --color-accent: #38bdf8;
        --color-accent-hover: #7dd3fc;
        --color-border: rgba(51, 65, 85, 0.6);
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.75;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        padding: clamp(24px, 5vw, 64px) clamp(16px, 4vw, 32px) 0;
        position: relative;
        overflow-x: hidden;
      }

      /* Prominent GPU Aurora Background Stage */
      .aurora-stage {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
      }

      .bg-grid {
        position: absolute;
        inset: 0;
        background-image: 
          linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 80%);
      }

      .aurora-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        will-change: transform, opacity;
      }

      .orb-1 {
        top: -100px;
        left: -80px;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, rgba(14, 165, 233, 0.06) 60%, transparent 80%);
        animation: floatOrb1 18s ease-in-out infinite alternate;
      }

      .orb-2 {
        bottom: -150px;
        right: -100px;
        width: 650px;
        height: 650px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, rgba(168, 85, 247, 0.06) 60%, transparent 80%);
        animation: floatOrb2 22s ease-in-out infinite alternate;
      }

      @keyframes floatOrb1 {
        0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.65; }
        50% { transform: translate3d(100px, 60px, 0) scale(1.18); opacity: 0.95; }
        100% { transform: translate3d(-40px, 110px, 0) scale(0.95); opacity: 0.7; }
      }

      @keyframes floatOrb2 {
        0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.6; }
        50% { transform: translate3d(-110px, -80px, 0) scale(1.2); opacity: 0.95; }
        100% { transform: translate3d(60px, -40px, 0) scale(0.92); opacity: 0.65; }
      }

      .container {
        max-width: 820px;
        margin: 0 auto;
        width: 100%;
        position: relative;
        z-index: 1;
      }

      .back-nav {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: clamp(20px, 4vw, 36px);
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .back-nav:hover {
        color: var(--color-accent-hover);
        transform: translateX(-2px);
      }

      h1.post-title {
        font-size: clamp(1.85rem, 4.5vw + 0.5rem, 2.75rem);
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 0 0 20px 0;
        word-break: break-word;
      }

      .cover-wrapper {
        width: 100%;
        margin: clamp(20px, 4vw, 36px) 0;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
      }

      img.cover {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
        max-height: 480px;
      }

      /* Content Typography */
      .content {
        font-size: clamp(1rem, 1.2vw + 0.75rem, 1.125rem);
        color: var(--color-text-body);
        padding-bottom: clamp(40px, 6vw, 64px);
        border-bottom: 1px solid var(--color-border);
      }

      .content :global(p) {
        margin: 0 0 1.5em 0;
      }

      .content :global(h2) {
        font-size: clamp(1.4rem, 2.5vw + 0.5rem, 1.85rem);
        line-height: 1.35;
        color: #f1f5f9;
        margin: 2em 0 0.75em 0;
        letter-spacing: -0.015em;
        font-weight: 700;
      }

      .content :global(h3) {
        font-size: clamp(1.2rem, 1.8vw + 0.5rem, 1.45rem);
        line-height: 1.4;
        color: #f1f5f9;
        margin: 1.75em 0 0.6em 0;
        font-weight: 600;
      }

      .content :global(ul),
      .content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em 0;
      }

      .content :global(li) {
        margin-bottom: 0.5em;
      }

      .content :global(blockquote) {
        margin: 1.75em 0;
        padding: 16px 22px;
        border-left: 4px solid var(--color-accent);
        background-color: rgba(56, 189, 248, 0.08);
        border-radius: 0 8px 8px 0;
        color: #e2e8f0;
        font-style: italic;
      }

      .content :global(pre) {
        background: #030712 !important;
        border: 1px solid #1e293b !important;
        border-left: 4px solid #38bdf8 !important;
        border-radius: 8px;
        padding: 18px 22px;
        overflow-x: auto;
        margin: 1.75em 0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
      }

      .content :global(pre code) {
        background: transparent !important;
        padding: 0 !important;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
        font-size: 0.92rem !important;
        line-height: 1.6 !important;
        color: #7dd3fc !important;
        display: block;
      }

      .content :global(:not(pre) > code) {
        font-size: 0.88em;
        background: #1e293b;
        color: #38bdf8;
        padding: 0.2em 0.45em;
        border-radius: 4px;
        border: 1px solid #334155;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        word-break: break-word;
      }

      /* Recent Articles Section */
      .recent-section {
        margin-top: clamp(40px, 6vw, 64px);
        padding-bottom: clamp(60px, 8vw, 96px);
      }

      .recent-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 24px;
      }

      .recent-header h2 {
        font-size: clamp(1.3rem, 2.5vw, 1.6rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0;
      }

      .all-articles-link {
        font-size: 0.9rem;
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
      }

      .all-articles-link:hover {
        color: var(--color-accent-hover);
      }

      .recent-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .recent-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .recent-card:hover {
        transform: translateY(-3px);
        border-color: var(--color-accent);
        background: var(--color-surface-hover);
        box-shadow: 0 10px 20px -10px rgba(56, 189, 248, 0.2);
      }

      .thumb-wrap {
        aspect-ratio: 16 / 9;
        width: 100%;
        background: #0f172a;
        overflow: hidden;
      }

      .thumb-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .recent-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .recent-card-body time {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-bottom: 6px;
      }

      .recent-card-body h3 {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        color: #f8fafc;
        margin: 0;
        transition: color 0.15s ease;
      }

      .recent-card:hover .recent-card-body h3 {
        color: var(--color-accent);
      }

      @media (max-width: 768px) {
        .recent-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 480px) {
        .recent-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="aurora-stage" aria-hidden="true">
      <div class="bg-grid"></div>
      <div class="aurora-orb orb-1"></div>
      <div class="aurora-orb orb-2"></div>
    </div>

    <main id="main-content">
      <article class="container">
        <a href="/blog" class="back-nav">&larr; Back to all posts</a>
        <h1 class="post-title">{post?.title}</h1>
        {post?.coverImageUrl && (
          <div class="cover-wrapper">
            <img 
              src={post.coverImageUrl} 
              alt={post?.coverImageAlt || post?.title} 
              width="1200" 
              height="630" 
              class="cover" 
              loading="eager" 
              decoding="async" 
            />
          </div>
        )}
        <div class="content">
          <PortableText value={post?.body} components={portableTextComponents} />
        </div>

        {recentPosts && recentPosts.length > 0 && (
          <section class="recent-section">
            <div class="recent-header">
              <h2>Recent Articles</h2>
              <a href="/blog" class="all-articles-link">View all &rarr;</a>
            </div>
            <div class="recent-grid">
              {recentPosts.map((item) => (
                <a href={`/blog/${item.slug}`} class="recent-card">
                  {item.coverImageUrl && (
                    <div class="thumb-wrap">
                      <img src={item.coverImageUrl} alt={item.coverImageAlt || item.title} loading="lazy" />
                    </div>
                  )}
                  <div class="recent-card-body">
                    <time datetime={item.publishedAt}>
                      {item.publishedAt ? new Date(item.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}
                    </time>
                    <h3>{item.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </main>
  </body>
</html>
