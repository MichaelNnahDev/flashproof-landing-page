---
import { sanityClient } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Link from "../../components/portabletext/Link.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{
    "params": { "slug": slug.current }
  }`);
  return posts;
}

const { slug } = Astro.params;

// Fetch current post
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    body,
    publishedAt,
    "coverImageUrl": mainImage.asset->url
  }`,
  { slug }
);

// Fetch the 6 most recent posts (excluding current post)
const recentPosts = await sanityClient.fetch(
  `*[_type == "post" && defined(slug.current) && slug.current != $slug] | order(publishedAt desc)[0...6] {
    title,
    "slug": slug.current,
    publishedAt,
    "coverImageUrl": mainImage.asset->url
  }`,
  { slug }
);

const portableTextComponents = {
  mark: {
    link: Link,
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post?.title ? `${post.title} — FlashProof` : "FlashProof Blog"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --color-bg: #0b0f19;
        --color-surface: #111827;
        --color-surface-hover: #1f2937;
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-text-body: #cbd5e1;
        --color-accent: #38bdf8;
        --color-accent-hover: #7dd3fc;
        --color-border: #1e293b;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.75;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        padding: clamp(24px, 5vw, 64px) clamp(16px, 4vw, 32px) 0;
      }

      .container {
        max-width: 820px;
        margin: 0 auto;
        width: 100%;
      }

      .back-nav {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: clamp(20px, 4vw, 36px);
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .back-nav:hover {
        color: var(--color-accent-hover);
        transform: translateX(-2px);
      }

      h1.post-title {
        font-size: clamp(1.85rem, 4.5vw + 0.5rem, 2.75rem);
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 0 0 20px 0;
        word-break: break-word;
      }

      .cover-wrapper {
        width: 100%;
        margin: clamp(20px, 4vw, 36px) 0;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
      }

      img.cover {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
        max-height: 480px;
      }

      /* Content Styling */
      .content {
        font-size: clamp(1rem, 1.2vw + 0.75rem, 1.125rem);
        color: var(--color-text-body);
        padding-bottom: clamp(40px, 6vw, 64px);
        border-bottom: 1px solid var(--color-border);
      }

      .content :global(p) {
        margin: 0 0 1.5em 0;
      }

      .content :global(h2) {
        font-size: clamp(1.4rem, 2.5vw + 0.5rem, 1.85rem);
        line-height: 1.35;
        color: #f1f5f9;
        margin: 2em 0 0.75em 0;
        letter-spacing: -0.015em;
        font-weight: 700;
      }

      .content :global(h3) {
        font-size: clamp(1.2rem, 1.8vw + 0.5rem, 1.45rem);
        line-height: 1.4;
        color: #f1f5f9;
        margin: 1.75em 0 0.6em 0;
        font-weight: 600;
      }

      .content :global(ul),
      .content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em 0;
      }

      .content :global(li) {
        margin-bottom: 0.5em;
      }

      .content :global(blockquote) {
        margin: 1.75em 0;
        padding: 14px 20px;
        border-left: 4px solid var(--color-accent);
        background-color: rgba(56, 189, 248, 0.05);
        border-radius: 0 8px 8px 0;
        color: #e2e8f0;
        font-style: italic;
      }

      .content :global(code) {
        font-size: 0.88em;
        background: #1e293b;
        color: #38bdf8;
        padding: 0.2em 0.4em;
        border-radius: 4px;
        word-break: break-word;
      }

      .content :global(pre) {
        background: #0f172a;
        padding: 16px 20px;
        border-radius: 8px;
        overflow-x: auto;
        border: 1px solid var(--color-border);
        margin: 1.75em 0;
      }

      .content :global(pre code) {
        background: transparent;
        padding: 0;
        color: #e2e8f0;
      }

      /* Recent Articles Section */
      .recent-section {
        margin-top: clamp(40px, 6vw, 64px);
        padding-bottom: clamp(60px, 8vw, 96px);
      }

      .recent-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 24px;
      }

      .recent-header h2 {
        font-size: clamp(1.3rem, 2.5vw, 1.6rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0;
      }

      .all-articles-link {
        font-size: 0.9rem;
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
      }

      .all-articles-link:hover {
        color: var(--color-accent-hover);
      }

      .recent-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .recent-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .recent-card:hover {
        transform: translateY(-3px);
        border-color: var(--color-accent);
        background: var(--color-surface-hover);
        box-shadow: 0 10px 20px -10px rgba(56, 189, 248, 0.15);
      }

      .thumb-wrap {
        aspect-ratio: 16 / 9;
        width: 100%;
        background: #0f172a;
        overflow: hidden;
      }

      .thumb-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .recent-card-body {
        padding: 14px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .recent-card-body time {
        font-size: 0.72rem;
        color: var(--color-text-muted);
        margin-bottom: 6px;
      }

      .recent-card-body h3 {
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.4;
        color: #f8fafc;
        margin: 0 0 12px 0;
        flex-grow: 1;
      }

      .read-link {
        font-size: 0.82rem;
        color: var(--color-accent);
        font-weight: 600;
        margin-top: auto;
      }

      @media (max-width: 768px) {
        .recent-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 480px) {
        .recent-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <article class="container">
      <a href="/blog" class="back-nav">&larr; Back to all posts</a>
      <h1 class="post-title">{post?.title}</h1>
      {post?.coverImageUrl && (
        <div class="cover-wrapper">
          <img src={post.coverImageUrl} alt={post.title} class="cover" loading="eager" />
        </div>
      )}
      <div class="content">
        <PortableText value={post?.body} components={portableTextComponents} />
      </div>

      {recentPosts && recentPosts.length > 0 && (
        <section class="recent-section">
          <div class="recent-header">
            <h2>Recent Articles</h2>
            <a href="/blog" class="all-articles-link">View all &rarr;</a>
          </div>
          <div class="recent-grid">
            {recentPosts.map((item) => (
              <a href={`/blog/${item.slug}`} class="recent-card">
                {item.coverImageUrl && (
                  <div class="thumb-wrap">
                    <img src={item.coverImageUrl} alt={item.title} loading="lazy" />
                  </div>
                )}
                <div class="recent-card-body">
                  <time datetime={item.publishedAt}>
                    {item.publishedAt ? new Date(item.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""}
                  </time>
                  <h3>{item.title}</h3>
                  <span class="read-link">Read article &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </body>
</html>
