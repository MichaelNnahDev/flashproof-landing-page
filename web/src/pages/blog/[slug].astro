---
import { sanityClient } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{
    "params": { "slug": slug.current }
  }`);
  return posts;
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    body,
    publishedAt,
    "coverImageUrl": mainImage.asset->url
  }`,
  { slug }
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post?.title} — FlashProof</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body { font-family: -apple-system, sans-serif; background: #0b0f19; color: #f8fafc; padding: 40px 20px; line-height: 1.7; }
      .container { max-width: 760px; margin: 0 auto; }
      h1 { font-size: 2.2rem; color: #fff; line-height: 1.3; }
      img.cover { width: 100%; border-radius: 12px; margin: 24px 0; }
      .content { font-size: 1.1rem; color: #cbd5e1; }
      a { color: #38bdf8; }
    </style>
  </head>
  <body>
    <article class="container">
      <a href="/blog">&larr; Back to all posts</a>
      <h1>{post?.title}</h1>
      {post?.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="cover" />}
      <div class="content">
        <PortableText value={post?.body} />
      </div>
    </article>
  </body>
</html>
