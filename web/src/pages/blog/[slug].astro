---
import { sanityClient } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Link from "../../components/portabletext/Link.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)]{
    "params": { "slug": slug.current }
  }`);
  return posts;
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title,
    body,
    publishedAt,
    "coverImageUrl": mainImage.asset->url
  }`,
  { slug }
);

const portableTextComponents = {
  mark: {
    link: Link,
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post?.title ? `${post.title} — FlashProof` : "FlashProof Blog"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --color-bg: #0b0f19;
        --color-surface: #111827;
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-text-body: #cbd5e1;
        --color-accent: #38bdf8;
        --color-accent-hover: #7dd3fc;
        --color-border: #1e293b;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.75;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        padding: clamp(24px, 5vw, 64px) clamp(16px, 4vw, 32px);
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
        width: 100%;
      }

      .back-nav {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: clamp(20px, 4vw, 36px);
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .back-nav:hover {
        color: var(--color-accent-hover);
        transform: translateX(-2px);
      }

      h1.post-title {
        font-size: clamp(1.85rem, 4.5vw + 0.5rem, 2.75rem);
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 0 0 20px 0;
        word-break: break-word;
      }

      .cover-wrapper {
        width: 100%;
        margin: clamp(20px, 4vw, 36px) 0;
        border-radius: 12px;
        overflow: hidden;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
      }

      img.cover {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
        max-height: 480px;
      }

      /* Fluid PortableText Typography & Element Styling */
      .content {
        font-size: clamp(1rem, 1.2vw + 0.75rem, 1.125rem);
        color: var(--color-text-body);
      }

      .content :global(p) {
        margin: 0 0 1.5em 0;
      }

      .content :global(h2) {
        font-size: clamp(1.4rem, 2.5vw + 0.5rem, 1.85rem);
        line-height: 1.35;
        color: #f1f5f9;
        margin: 2em 0 0.75em 0;
        letter-spacing: -0.015em;
        font-weight: 700;
      }

      .content :global(h3) {
        font-size: clamp(1.2rem, 1.8vw + 0.5rem, 1.45rem);
        line-height: 1.4;
        color: #f1f5f9;
        margin: 1.75em 0 0.6em 0;
        font-weight: 600;
      }

      .content :global(ul),
      .content :global(ol) {
        padding-left: 1.4em;
        margin: 0 0 1.5em 0;
      }

      .content :global(li) {
        margin-bottom: 0.5em;
      }

      .content :global(blockquote) {
        margin: 1.75em 0;
        padding: 14px 20px;
        border-left: 4px solid var(--color-accent);
        background-color: rgba(56, 189, 248, 0.05);
        border-radius: 0 8px 8px 0;
        color: #e2e8f0;
        font-style: italic;
      }

      .content :global(code) {
        font-size: 0.88em;
        background: #1e293b;
        color: #38bdf8;
        padding: 0.2em 0.4em;
        border-radius: 4px;
        word-break: break-word;
      }

      .content :global(pre) {
        background: #0f172a;
        padding: 16px 20px;
        border-radius: 8px;
        overflow-x: auto;
        border: 1px solid var(--color-border);
        margin: 1.75em 0;
      }

      .content :global(pre code) {
        background: transparent;
        padding: 0;
        color: #e2e8f0;
      }

      @media (max-width: 480px) {
        .content :global(ul),
        .content :global(ol) {
          padding-left: 1.1em;
        }
      }
    </style>
  </head>
  <body>
    <article class="container">
      <a href="/blog" class="back-nav">&larr; Back to all posts</a>
      <h1 class="post-title">{post?.title}</h1>
      {post?.coverImageUrl && (
        <div class="cover-wrapper">
          <img src={post.coverImageUrl} alt={post.title} class="cover" loading="eager" />
        </div>
      )}
      <div class="content">
        <PortableText value={post?.body} components={portableTextComponents} />
      </div>
    </article>
  </body>
</html>