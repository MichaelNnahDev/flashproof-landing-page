---
interface Props {
  name?: string;
  role?: string;
  bio?: string;
  avatarUrl?: string;
  githubUrl?: string;
  websiteUrl?: string;
}

const {
  name = "Michael Nnah",
  role = "Cloud & Full-Stack Engineer | Creator of FlashProof",
  bio = "Specializing in high-performance web architecture, AWS infrastructure, and frictionless e-commerce tooling. Built FlashProof to solve the bloated, overpriced social proof plugin problem for WooCommerce store owners.",
  avatarUrl = "/images/author-avatar.webp",
  githubUrl = "https://github.com/MichaelNnahDev",
  websiteUrl = "https://portfolio.michaelnnah.com",
} = Astro.props;
---

<section class="author-section">
  <div class="author-card">
    <div class="author-avatar-wrap">
      <img src={avatarUrl} alt={name} class="author-avatar" loading="lazy" />
      <span class="status-indicator" title="Active Developer"></span>
    </div>
    <div class="author-details">
      <span class="author-label">Meet the Developer</span>
      <h3 class="author-name">{name}</h3>
      <p class="author-role">{role}</p>
      <p class="author-bio">{bio}</p>
      <div class="author-links">
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="author-link">
            GitHub &rarr;
          </a>
        )}
        {websiteUrl && (
          <a href={websiteUrl} target="_blank" rel="noopener noreferrer" class="author-link">
            Portfolio &rarr;
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .author-section {
    padding: clamp(40px, 6vw, 80px) clamp(16px, 4vw, 32px);
    max-width: 820px;
    margin: 0 auto;
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 36px);
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 16px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4);
  }

  .author-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .author-avatar {
    width: clamp(80px, 12vw, 110px);
    height: clamp(80px, 12vw, 110px);
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #38bdf8;
    background: #0f172a;
  }

  .status-indicator {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #10b981;
    border: 2px solid #111827;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
    margin-bottom: 6px;
  }

  .author-name {
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 4px 0;
    letter-spacing: -0.01em;
  }

  .author-role {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0 0 12px 0;
    font-weight: 500;
  }

  .author-bio {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0 0 16px 0;
  }

  .author-links {
    display: flex;
    gap: 16px;
  }

  .author-link {
    font-size: 0.88rem;
    color: #38bdf8;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .author-link:hover {
    color: #7dd3fc;
  }

  @media (max-width: 600px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .author-links {
      justify-content: center;
    }
  }
</style>
