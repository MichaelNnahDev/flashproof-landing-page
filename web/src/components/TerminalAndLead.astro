---
// web/src/components/TerminalAndLead.astro
interface Props {
  terminal: {
    title?: string;
    subtitle?: string;
    command?: string;
  };
  leadCapture: {
    tag?: string;
    title?: string;
    description?: string;
    buttonText?: string;
    privacyNotice?: string;
  };
}

const { terminal, leadCapture } = Astro.props;

const defaultCommand =
  "wp plugin install https://github.com/MichaelNnahDev/flashproof-sales-popup-for-woo/archive/refs/heads/main.zip --force --activate";
---

<!-- Installation & WP-CLI Section -->
<section class="install-section" aria-labelledby="install-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="install-heading" class="section-title">{terminal.title || "One-Line WP-CLI Installation"}</h2>
      <p class="section-sub">{terminal.subtitle || "Deploy directly from your server terminal in under 5 seconds."}</p>
    </div>

    <div class="terminal-box">
      <div class="terminal-header">
        <div class="terminal-dots" aria-hidden="true">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <span class="terminal-title">bash — public_html</span>
        <button type="button" class="copy-btn" id="btn-copy-cli" aria-label="Copy installation command to clipboard">
          <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-label">Copy</span>
        </button>
      </div>
      <pre class="terminal-body"><code id="cli-code">{terminal.command || defaultCommand}</code></pre>
    </div>
  </div>
</section>

<!-- WPCode Snippet Lead Capture Form Section -->
<section id="lead-capture" class="form-section" aria-labelledby="form-heading">
  <div class="container">
    <div class="form-card">
      <div class="form-header">
        <span class="tag-badge">{leadCapture.tag || "NO PLUGIN REQUIRED"}</span>
        <h2 id="form-heading" class="form-title">{leadCapture.title || "Prefer adding raw PHP/JS via WPCode?"}</h2>
        <p class="form-desc">
          {leadCapture.description || "Don't want to install an extra plugin on your WooCommerce store? Enter your email to instantly receive the clean PHP backend handler and frontend CSS/JS scripts ready to paste directly into WPCode, Code Snippets, or your theme's functions.php."}
        </p>
      </div>

      <form id="wclsp-lead-form" class="snippet-form" novalidate>
        <div class="input-group">
          <label for="wclsp_name" class="sr-only">Your Name</label>
          <input
            type="text"
            name="name"
            id="wclsp_name"
            placeholder="Your Name"
            required
            class="form-input"
          />

          <label for="wclsp_email" class="sr-only">Your Work Email</label>
          <input
            type="email"
            name="email"
            id="wclsp_email"
            placeholder="Your Work Email"
            required
            class="form-input"
          />

          <input type="hidden" name="domain" value="wclsp.michaelnnah.com" />
          <input type="hidden" name="plugin_version" value="1.2.0" />

          <button type="submit" id="wclsp_submit_btn" class="btn-submit">
            <span id="submit-text">{leadCapture.buttonText || "Send Snippet Package"}</span>
            <svg class="submit-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <p class="form-notice">
          {leadCapture.privacyNotice || "🔒 Instant delivery. We respect your inbox and never send spam."}
        </p>
      </form>

      <div id="wclsp-form-success" class="form-alert success" style="display: none;" role="status">
        ✅ Code snippet package dispatched! Check your inbox shortly.
      </div>
      <div id="wclsp-form-error" class="form-alert error" style="display: none;" role="alert">
        Could not deliver snippets right now. Please verify your email or try again shortly.
      </div>
    </div>
  </div>
</section>

<script>
  // Copy CLI command
  const copyBtn = document.getElementById('btn-copy-cli');
  const cliCode = document.getElementById('cli-code');
  const copyLabel = document.getElementById('copy-label');

  copyBtn?.addEventListener('click', () => {
    if (!cliCode || !copyLabel) return;
    navigator.clipboard.writeText(cliCode.textContent?.trim() || '').then(() => {
      copyLabel.textContent = 'Copied!';
      copyBtn.classList.add('copied');
      setTimeout(() => {
        copyLabel.textContent = 'Copy';
        copyBtn.classList.remove('copied');
      }, 2000);
    });
  });

  // Lead Form submission via FormData payload
  const form = document.getElementById('wclsp-lead-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('wclsp_submit_btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const successBox = document.getElementById('wclsp-form-success');
  const errorBox = document.getElementById('wclsp-form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('wclsp_name') as HTMLInputElement | null;
    const emailInput = document.getElementById('wclsp_email') as HTMLInputElement | null;
    const email = emailInput?.value.trim() || '';

    if (errorBox) errorBox.style.display = 'none';
    if (successBox) successBox.style.display = 'none';

    if (!email || !email.includes('@')) {
      if (errorBox) {
        errorBox.textContent = 'Please enter a valid email address.';
        errorBox.style.display = 'block';
      }
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'Sending...';

    const formData = new FormData(form);
    formData.set('name', nameInput?.value.trim() || '');
    formData.set('email', email);
    formData.set('domain', 'wclsp.michaelnnah.com');
    formData.set('plugin_version', '1.2.0');

    try {
      const res = await fetch('https://michaelnnah.com/api/wclsp-leads.php', {
        method: 'POST',
        body: formData,
      });

      if (!res.ok) throw new Error('Bad response status');

      // Hide form and display success
      form.style.display = 'none';
      if (successBox) successBox.style.display = 'block';
    } catch {
      if (errorBox) {
        errorBox.textContent = 'Could not deliver snippets right now. Please verify your email or try again shortly.';
        errorBox.style.display = 'block';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitText) submitText.textContent = 'Send Snippet Package';
    }
  });
</script>

<style>
  /* Common Section Header */
  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 28px;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.8vw, 2.3rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
  }

  .section-sub {
    font-size: 1rem;
    color: #64748b;
  }

  /* Installation Section */
  .install-section {
    padding: 60px 0 70px;
  }

  .terminal-box {
    max-width: 820px;
    margin: 0 auto;
    background: #0f172a;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.25);
    text-align: left;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #1e293b;
    border-bottom: 1px solid #334155;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .terminal-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: #94a3b8;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #334155;
    border: none;
    color: #f8fafc;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
    font-family: inherit;
  }

  .copy-btn:hover { background: #475569; }
  .copy-btn.copied { background: #10b981; }

  .terminal-body {
    padding: 18px 20px;
    margin: 0;
    overflow-x: auto;
  }

  .terminal-body code {
    color: #38bdf8;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* Lead Capture Form Section */
  .form-section {
    padding: 30px 0 80px;
  }

  .form-card {
    max-width: 820px;
    margin: 0 auto;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 18px;
    padding: 40px 36px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
  }

  .tag-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4f46e5;
    background: #eef2ff;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
  }

  .form-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
  }

  .form-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 24px;
  }

  .input-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .form-input {
    flex: 1 1 200px;
    height: 46px;
    padding: 0 16px;
    font-size: 0.9rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #f8fafc;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    font-family: inherit;
  }

  .form-input:focus {
    border-color: #4f46e5;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #4f46e5;
    color: #ffffff;
    height: 46px;
    padding: 0 22px;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease;
    font-family: inherit;
  }

  .btn-submit:hover { background: #4338ca; }
  .btn-submit:disabled { background: #94a3b8; cursor: not-allowed; }

  .form-notice {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-top: 12px;
  }

  .form-alert {
    margin-top: 18px;
    padding: 16px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }

  .form-alert.success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .form-alert.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .form-card {
      padding: 26px 20px;
    }

    .input-group {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .form-input, .btn-submit {
      width: 100%;
      height: 44px;
    }
  }
</style>