---
// src/components/TerminalAndLead.astro
interface Props {
  terminal: {
    title?: string;
    subtitle?: string;
    command?: string;
  };
  leadCapture: {
    tag?: string;
    title?: string;
    description?: string;
    buttonText?: string;
    privacyNotice?: string;
  };
}

const { terminal, leadCapture } = Astro.props;
---

<section class="deployment-section">
  <div class="container">
    <!-- Terminal Area -->
    <div class="terminal-wrapper">
      {terminal.subtitle && <p class="terminal-subtitle">{terminal.subtitle}</p>}
      
      <div class="terminal-window">
        <div class="terminal-header">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot dot-red"></span>
            <span class="dot dot-amber"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="terminal-title">bash — public_html</div>
          <button type="button" class="btn-copy" id="copy-btn" aria-label="Copy installation command">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-text">Copy</span>
          </button>
        </div>

        <div class="terminal-body">
          <pre><code id="cli-cmd">{terminal.command || "wp plugin install https://github.com/MichaelNnahDev/flashproof-sales-popup-for-woo/archive/refs/heads/main.zip --force --activate"}</code></pre>
        </div>
      </div>
    </div>

    <!-- Lead Capture Section -->
    <div class="lead-wrapper" id="lead-capture">
      <div class="lead-card">
        {leadCapture.tag && <span class="lead-pill">{leadCapture.tag}</span>}
        <h2 class="lead-title">{leadCapture.title || "Prefer adding raw PHP/JS via WPCode?"}</h2>
        <p class="lead-desc">
          Don't want to install an extra plugin on your WooCommerce store? Enter your email to instantly receive the clean PHP backend handler and frontend CSS/JS scripts ready to paste directly into WPCode, Code Snippets, or your theme's <code class="inline-code">functions.php</code>.
        </p>

        <form id="lead-form" class="lead-form" novalidate>
          <div class="lead-inputs">
            <input
              type="text"
              id="lead-name"
              name="name"
              class="form-input"
              placeholder="Your Name"
              required
            />
            <input
              type="email"
              id="lead-email"
              name="email"
              class="form-input"
              placeholder="Your Work Email"
              required
            />
            <button type="submit" class="btn-submit" id="lead-submit">
              <span>{leadCapture.buttonText || "Send Snippet Package"}</span>
              <span class="btn-arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>

          <div id="lead-status" class="lead-status" aria-live="polite"></div>

          {leadCapture.privacyNotice && (
            <p class="lead-privacy">
              {leadCapture.privacyNotice}
            </p>
          )}
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Terminal Clipboard Copy
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');
  const cliCmd = document.getElementById('cli-cmd');

  if (copyBtn && cliCmd && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cliCmd.innerText.trim());
        copyText.textContent = 'Copied!';
        setTimeout(() => { copyText.textContent = 'Copy'; }, 2000);
      } catch (err) {
        copyText.textContent = 'Failed';
      }
    });
  }

  // Lead Form Submission via /api/wclsp-leads.php
  const leadForm = document.getElementById('lead-form') as HTMLFormElement | null;
  const leadStatus = document.getElementById('lead-status');
  const leadSubmit = document.getElementById('lead-submit') as HTMLButtonElement | null;

  if (leadForm && leadStatus && leadSubmit) {
    leadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('lead-name') as HTMLInputElement;
      const emailInput = document.getElementById('lead-email') as HTMLInputElement;

      const name = nameInput?.value.trim();
      const email = emailInput?.value.trim();

      if (!email || !email.includes('@')) {
        leadStatus.textContent = 'Please enter a valid email address.';
        leadStatus.className = 'lead-status error';
        return;
      }

      leadSubmit.disabled = true;
      leadSubmit.innerHTML = '<span>Sending...</span>';
      leadStatus.textContent = '';

      try {
        const res = await fetch('/api/wclsp-leads.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email }),
        });

        if (res.ok) {
          leadStatus.textContent = 'Snippet package sent! Check your inbox.';
          leadStatus.className = 'lead-status success';
          leadForm.reset();
        } else {
          leadStatus.textContent = 'Unable to send right now. Please try again.';
          leadStatus.className = 'lead-status error';
        }
      } catch {
        leadStatus.textContent = 'Network error. Please try again shortly.';
        leadStatus.className = 'lead-status error';
      } finally {
        leadSubmit.disabled = false;
        leadSubmit.innerHTML = '<span>Send Snippet Package</span> <span class="btn-arrow">&rarr;</span>';
      }
    });
  }
</script>

<style>
  .deployment-section {
    padding: 20px 0 100px;
  }

  /* Terminal Window */
  .terminal-wrapper {
    max-width: 820px;
    margin: 0 auto 70px;
    text-align: center;
  }

  .terminal-subtitle {
    font-size: 0.95rem;
    color: #475569;
    margin-bottom: 20px;
  }

  .terminal-window {
    background: #0f172a;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    text-align: left;
    border: 1px solid #1e293b;
  }

  .terminal-header {
    background: #1e293b;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-amber { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .terminal-title {
    color: #94a3b8;
    font-size: 0.78rem;
    font-family: var(--font-mono);
  }

  .btn-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #334155;
    border: none;
    color: #f8fafc;
    padding: 5px 12px;
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease;
  }

  .btn-copy:hover {
    background: #475569;
  }

  .terminal-body {
    padding: 24px;
    overflow-x: auto;
  }

  .terminal-body pre {
    margin: 0;
  }

  .terminal-body code {
    font-family: var(--font-mono);
    color: #38bdf8;
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* Lead Capture Card */
  .lead-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  .lead-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 48px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
  }

  .lead-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #4f46e5;
    background: #eef2ff;
    padding: 4px 12px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 18px;
  }

  .lead-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: #0b0f19;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .lead-desc {
    color: #475569;
    font-size: 0.98rem;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .inline-code {
    font-family: var(--font-mono);
    background: #f1f5f9;
    color: #0f172a;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .lead-inputs {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .form-input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    background: #f8fafc;
    color: #0f172a;
    transition: all 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    background: #ffffff;
    border-color: #4f46e5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #4f46e5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.1s ease;
    font-family: inherit;
  }

  .btn-submit:hover {
    background: #4338ca;
  }

  .btn-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  .lead-privacy {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 14px;
  }

  .lead-status {
    margin-top: 10px;
    font-size: 0.85rem;
  }

  .lead-status.success { color: #16a34a; }
  .lead-status.error { color: #dc2626; }

  @media (max-width: 768px) {
    .lead-card {
      padding: 32px 24px;
    }

    .lead-inputs {
      flex-direction: column;
    }

    .btn-submit {
      justify-content: center;
    }
  }
</style>